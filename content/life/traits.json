{
  "version": 1,
  "description": "天赋的效果（玩法设计第七节「悟得」末段，执行计划第 48 项）：content/creation.json 的 148 条天赋，按名字各配上引擎读得懂的效果，用悟得的那套写法（content/life/perks.json 的 effect：type 加几个数），一条天赋可以有几样。天赋自己的文字和加属性的那部分在建角的文件里，这里不动它们，建角的对照样本不变；这里的效果也都不碰人物表的属性列（许诺属性成长的，像鸿蒙金榜，只当文字）。kinds 是认得的类型：live 的现在就有规则读（写的是读它的模块），item 的等那一项做出来再读，在那之前不起作用。only「文字」是实在落不到规则上的，只当说明给模型看，不超过三成。apps/engine/life/traits.cjs 读这份文件；数都是初值。",
  "checks": [
    "交涉",
    "欺瞒",
    "探查",
    "潜行",
    "脱身",
    "硬闯",
    "施术",
    "搏运",
    "强攻",
    "用物",
    "买卖",
    "静观"
  ],
  "crafts": [
    "炼丹",
    "炼器",
    "制符",
    "布阵",
    "驭兽"
  ],
  "kinds": {
    "bonus": {
      "live": "speed",
      "notes": "修炼的加成池（content/life/verbs.json 的 cultivate.bonus 封顶）：value 是比例；when 是 night（夜里）、day（白天）、hurt（身上带着伤病：状态不是「一切正常」，或内伤未愈）；method 是主修功法的字（魔、佛）；placeKinds 是地点的种类"
    },
    "checkBonus": {
      "live": "actions",
      "notes": "kinds 里这几种检定的修正加 value（遭遇的探查也算）"
    },
    "tierDown": {
      "live": "actions",
      "notes": "kinds 里这几种检定降 steps 档；when night 只在夜里"
    },
    "insight": {
      "live": "actions",
      "notes": "kinds 里这几种行动卡多看到对方的态度"
    },
    "hitBonus": {
      "live": "fight",
      "notes": "斗法里命中加 value：when firstStrike 只在先手的第一手，hurt 带伤时；placeKinds 是地点的种类；weapon 是兵器名字里的字；unarmed 是空手"
    },
    "poisonCap": {
      "live": "poison",
      "notes": "丹毒的上限加 value"
    },
    "toxin": {
      "live": "poison",
      "notes": "每枚丹药加的丹毒乘 factor（四舍五入）"
    },
    "fortune": {
      "live": "rewards",
      "notes": "月结奇遇的几率加 value 个百分点（不低于零）"
    },
    "gather": {
      "live": "rewards",
      "notes": "采集得的 classes 那几类，份数乘 1 + value（四舍五入）"
    },
    "gateOdds": {
      "live": "gate",
      "notes": "冲关的修正加 value"
    },
    "knotCap": {
      "live": "gate",
      "notes": "心结让冲关减的修正，封底少减 value（content/life/gates.json 的 odds.knots.most）"
    },
    "affinity": {
      "live": "speed",
      "notes": "功法和灵根的五行不契合时不减速（契合）"
    },
    "craft": {
      "live": "crafts",
      "notes": "kinds（炼丹、炼器、制符、布阵、驭兽）这几门技艺的检定加 value（第 42 项的炼制）"
    },
    "trade": {
      "item": 35,
      "notes": "买的时候便宜 value 的比例；第 35 项「买卖」读它"
    },
    "appraise": {
      "item": 35,
      "notes": "看得到货的真实品阶和底价（悟得「识货」那一种）；第 35 项读它"
    },
    "guard": {
      "item": 33,
      "notes": "斗法里受的伤乘 1 − value（element 只对那一行的法术）；斗法的护体（第 33、34 项的装备特性一起做）时读它"
    },
    "spell": {
      "item": 33,
      "notes": "法术：value 是威力的比例（element 那一行的、words 名字里有这些字的），cost 是耗法力的比例，heal 是疗伤法术的比例；斗法的法术那边读它"
    },
    "rest": {
      "item": 45,
      "notes": "调息、养伤回复得快 value 的比例；洞府（第 45 项）改调息时一起读它"
    },
    "learn": {
      "live": "crafts",
      "notes": "技艺的熟练度长得快 value 的比例（第 42 项：做成一炉记 1 + value）；功法的领悟以后也读它"
    }
  },
