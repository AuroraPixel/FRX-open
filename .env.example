# Optional server-side model connection. Leave these commented to configure
# the model through the game's Model connection panel instead.
# FRX_API_BASE=https://your-provider.example/v1
# FRX_MODEL=your-chat-model
# FRX_API_KEY=your-api-key

# Optional Compose host ports; defaults are 8787 and 55432.
# FRX_WEB_PORT=8787
# FRX_DB_PORT=55432

# Optional email-code sign-in (accounts mode, FRX_AUTH=on).
# Keep credentials in an untracked private FRX_DATA_DIR/mail.json (chmod 600),
# or supply these through the server environment. Never put them in frontend settings.
# FRX_SMTP_CONFIG=/absolute/private/path/mail.json
# FRX_SMTP_HOST=smtp.example.com
# FRX_SMTP_PORT=465
# FRX_SMTP_SECURITY=ssl
# FRX_SMTP_USERNAME=no-reply@example.com
# FRX_SMTP_PASSWORD=replace-with-mailbox-password
# FRX_SMTP_FROM=no-reply@example.com
# FRX_EMAIL_CODE_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Use port 587 with security=starttls if needed; plaintext delivery is not supported.
