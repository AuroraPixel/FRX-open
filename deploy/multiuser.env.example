# Settings of the multi-user deployment (compose.multiuser.yaml). Copy to deploy/multiuser.env,
# fill in, and keep the copy out of git and out of any chat or document.

# The public host name the proxy serves over HTTPS (for a rehearsal on this machine:
# frx.localhost, with Caddy's own certificate).
FRX_HOST=

# The schema owner's and the server's database passwords (long random strings).
FRX_DB_OWNER_PASSWORD=
FRX_DB_APP_PASSWORD=

# The model connection (FRX_API_BASE, FRX_API_KEY, FRX_MODEL, ...): a file of its own.
FRX_MODEL_ENV_FILE=.env

# invite (default), closed or open.
FRX_REGISTRATION=invite

# The proxy's ports, 80 and 443 on every address of the server when not set. A rehearsal on a
# machine that runs other things keeps to its own ports on this machine only, for example
# FRX_HTTP_PORT=127.0.0.1:9227 and FRX_HTTPS_PORT=127.0.0.1:9225 (open https://frx.localhost:9225/).
# FRX_HTTP_PORT=80
# FRX_HTTPS_PORT=443

# Limits (defaults shown; "none" is no limit). Per player over the last 24 hours, per player at
# once, for the whole server at once, and what a player may keep.
# FRX_LIMIT_COST=3
# FRX_LIMIT_TURNS=200
# FRX_LIMIT_CONCURRENT=2
# FRX_LIMIT_SERVER_TURNS=6
# FRX_LIMIT_SAVES=50
# FRX_LIMIT_SAVE_MB=50
# FRX_LIMIT_IMAGE_MB=200
# FRX_SESSION_DAYS=30
